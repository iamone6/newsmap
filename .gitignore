# ---- 환경변수 (각 앱의 .env 는 커밋하지 않고 .env.example 만 커밋) ----
.env
.env.*
!.env.example

# ---- 로컬 전용 docker compose 설정 ----
docker-compose.override.yml

# ---- 운영 서버에서 deploy/deploy.sh 가 남기는 현재 배포 태그 ----
deploy/.current-tag

# ---- OS / 에디터 ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ---- 로그 ----
*.log
logs/

# ---- DB 덤프 / 행정동 원본 데이터 ----
*.dump
*.sql.gz
*.csv
*.xlsx

# ---- Node (apps/fe 등) ----
node_modules/
dist/
build/
.next/
.nuxt/
.output/
coverage/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Laravel (apps/be) ----
apps/be/vendor/
apps/be/public/hot
apps/be/public/storage
apps/be/public/build
apps/be/storage/*.key
# storage/logs·storage/framework/{cache,sessions,testing,views} 는 디렉터리째 무시하지 않는다.
# 각 디렉터리의 Laravel 기본 .gitignore(*, !.gitignore)가 내용물만 무시해 빈 디렉터리가 커밋되어야
# CI checkout 과 운영 이미지에 뷰 캐시 경로가 생긴다 (없으면 /up 이 "valid cache path" 500).
# storage/logs 는 위의 공통 logs/ 규칙에 걸리므로 디렉터리만 다시 포함한다.
!apps/be/storage/logs/
apps/be/bootstrap/cache/*.php
.phpunit.result.cache
.phpunit.cache/

# ---- Python (apps/rag) ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/
apps/rag/logs/

# ---- Hugging Face 토크나이저/모델 캐시 ----
.cache/

# ---- graphify: 결과물(graph.json·GRAPH_REPORT.md·graph.html)만 커밋, 로컬 경로·캐시는 제외 ----
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
