# 카카오맵 JavaScript 키 (비우면 SVG 폴리곤 지도로 동작)
# Kakao Developers → 내 애플리케이션 → 플랫폼 > Web 에 접속 도메인(예: http://localhost:4000)을 등록해야 한다
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
# be API 주소. be(FrankenPHP)가 앞단이라 같은 도메인의 상대 경로를 쓴다 (예: /api/v1)
NEXT_PUBLIC_API_BASE_URL=
# true 면 be 대신 가짜(mock) 데이터를 쓴다
NEXT_PUBLIC_USE_MOCK_API=
