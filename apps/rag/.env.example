# Python 수집/청킹/임베딩 워커. DB 접속 정보는 apps/db/.env 와 맞춘다.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=newsmap
DB_USERNAME=newsmap
DB_PASSWORD=change-me

# DeepInfra (OpenAI 호환 API). 키는 이 파일에만 두고 소스/프론트엔드에 넣지 않는다.
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# 임베딩: 차원을 바꾸면 contracts/schema.sql 의 halfvec(1024) 도 함께 바꾸고 전체 재임베딩해야 한다.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024

# 지역/기자/통신사/섹션/이미지 라이선스 판단용 LLM
LLM_MODEL=

# 청킹 (토큰 수는 Qwen3 토크나이저 기준, 오버랩 포함 최대값)
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_RATIO=0.1

# 실행 1회당 피드 하나에서 처리할 신규 기사 수 상한. 넘치는 나머지는 다음 실행에서 처리된다.
MAX_ITEMS_PER_BATCH=50

# --feed-key ALL 실행 시 피드를 동시에 몇 개까지 병렬로 처리할지. DeepInfra 쪽 동시 요청
# 제한을 몰라 보수적으로 시작한다. 로그에 429/rate-limit 에러가 없으면 올려봐도 된다.
MAX_CONCURRENT_FEEDS=4
