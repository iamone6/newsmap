# apps/be 환경변수. 키 목록만 둔다. 실제 값은 apps/be/.env 에 넣고 커밋하지 않는다.
# 컨테이너 환경변수(env_file)라 값을 바꾸면 docker compose up -d --force-recreate be 로 다시 만들어야 반영된다.

# ---- 앱 ----
# 앱 이름 (로그·메일 등에 쓰임). 예) newsmap
APP_NAME=
# 실행 환경: local | production. local 이면 TestUserSeeder 를 실행할 수 있다
APP_ENV=
# 암호화 키. docker compose exec be php artisan key:generate --show 로 만든다 (base64:...)
APP_KEY=
# true 면 에러 응답에 예외·trace 가 나온다. prod 는 반드시 false
APP_DEBUG=
# 서비스 주소. 로컬 http://localhost:4000, prod 는 https://도메인
APP_URL=

# ---- 로그 ----
# 로그 채널. stderr 로 내보내 docker compose logs be 로 본다
LOG_CHANNEL=
# 기록할 최소 수준: debug | info | warning | error
LOG_LEVEL=

# ---- DB (apps/db/.env 의 POSTGRES_* 와 맞춘다) ----
# DB 드라이버: pgsql
DB_CONNECTION=
# DB 호스트. compose 가 db 로 덮어쓴다
DB_HOST=
# DB 포트: 5432
DB_PORT=
# DB 이름 = POSTGRES_DB (테스트는 phpunit.xml 이 newsmap_test 로 덮어쓴다)
DB_DATABASE=
# DB 사용자 = POSTGRES_USER
DB_USERNAME=
# DB 비밀번호 = POSTGRES_PASSWORD
DB_PASSWORD=

# ---- 세션·캐시·큐 (API 는 Bearer 토큰 기반 무상태) ----
# 세션 저장소: array (세션을 쓰지 않음)
SESSION_DRIVER=
# 캐시 저장소: file. 통계 캐시·쿼리 임베딩 캐시·요청 제한(rate limit) 카운터가 여기 쌓인다.
# 서버를 여러 대로 늘리면 redis 같은 공유 저장소로 바꾼다
CACHE_STORE=
# 큐: sync (큐 작업 없음)
QUEUE_CONNECTION=

# ---- FrankenPHP / Octane (apps/be/Caddyfile) ----
# Octane 서버: frankenphp
OCTANE_SERVER=
# Caddy 사이트 주소. 로컬 :80 (HTTP 만), prod 는 도메인 (HTTPS 인증서 자동 발급)
SERVER_NAME=
# /api 외 화면 요청을 넘길 곳. 기본 fe:3000, fe 를 호스트 dev 서버로 띄울 때 host.docker.internal:4001
FE_UPSTREAM=

# ---- 검색 ----
# 검색(search_chunks 의 p_exclude_wire)에서 통신사 기사를 뺄지: true | false
RAG_EXCLUDE_WIRE=

# ---- 검색 쿼리 임베딩 (apps/rag/.env 와 같은 값. 모델·차원이 다르면 검색 결과가 맞지 않는다) ----
# DeepInfra API 키. 비어 있거나 호출이 실패하면 검색은 BM25 만으로 동작한다 (meta.search_type=bm25)
DEEPINFRA_API_KEY=
# OpenAI 호환 API 주소: https://api.deepinfra.com/v1/openai
DEEPINFRA_BASE_URL=
# 임베딩 모델: Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL=
# 임베딩 차원: 1024 (schema.sql 의 halfvec(1024) 와 같아야 한다)
EMBEDDING_DIMENSIONS=
