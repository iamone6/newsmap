# apps/be 환경변수. 키 목록만 둔다. 실제 값은 apps/be/.env 에 넣고 커밋하지 않는다.

# ---- 앱 ----
# APP_ENV: local | production, APP_KEY: php artisan key:generate 로 생성
APP_NAME=
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_URL=

# ---- 로그 (컨테이너는 stderr 로 내보내 docker compose logs 로 본다) ----
LOG_CHANNEL=
LOG_LEVEL=

# ---- DB (apps/db/.env 의 POSTGRES_* 와 맞춘다. compose 안에서는 DB_HOST 가 db 로 고정됨) ----
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---- 세션·캐시·큐 (API 는 무상태: 세션 array, 캐시 file, 큐 sync) ----
SESSION_DRIVER=
CACHE_STORE=
QUEUE_CONNECTION=

# ---- FrankenPHP / Octane (apps/be/Caddyfile) ----
# OCTANE_SERVER: frankenphp
# SERVER_NAME: 로컬 :80 (HTTP 만), prod 는 도메인 (HTTPS 자동 발급)
# FE_UPSTREAM: 화면 요청을 넘길 곳. 기본 fe:3000, fe 를 호스트 dev 서버로 띄울 때 host.docker.internal:4001
OCTANE_SERVER=
SERVER_NAME=
FE_UPSTREAM=

# ---- 검색 ----
# search_chunks() 의 p_exclude_wire 로 넘길 기본값 (통신사 기사 제외 여부)
RAG_EXCLUDE_WIRE=

# ---- 검색 쿼리 임베딩 (apps/rag/.env 와 같은 값. 모델·차원이 다르면 검색 결과가 맞지 않는다) ----
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
